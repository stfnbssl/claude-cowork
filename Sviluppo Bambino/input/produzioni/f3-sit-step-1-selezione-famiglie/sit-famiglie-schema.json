{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "f3-sit-step-1-selezione-famiglie-schema",
  "title": "F3-SIT Step 1 — Selezione delle famiglie situazionali",
  "type": "object",
  "required": ["step", "tema_id", "domain_selected", "results"],
  "properties": {
    "step": { "const": "f3_sit_step_1" },
    "tema_id": { "type": "string" },
    "domain_selected": { "enum": ["clinico", "educativo", "formazione", "politiche"] },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["device_reference", "selected_families", "excluded_families", "narrative_families_selected"],
        "properties": {
          "device_reference": {
            "type": "object",
            "description": "Campi di tracciabilità ereditati dal dispositivo F3 validato.",
            "required": ["dominant_node", "function", "target_field", "universal_device_type"],
            "properties": {
              "source_device_id": { "type": ["string", "null"] },
              "dominant_node": { "type": "string", "minLength": 1 },
              "function": { "enum": ["stabilizzare", "ampliare", "mediare", "proteggere"] },
              "target_field": { "type": "string", "minLength": 1 },
              "universal_device_type": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["U1", "U2", "U3", "U4", "U5", "U6"] }
              }
            }
          },
          "selected_families": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["family_id", "family_name", "priority", "target_user", "reason", "expected_items"],
              "properties": {
                "family_id": {
                  "enum": ["F3-SIT-1", "F3-SIT-2", "F3-SIT-3", "F3-SIT-4", "F3-SIT-5", "F3-SIT-6", "F3-SIT-7", "F3-SIT-8", "F3-SIT-9"]
                },
                "family_name": { "type": "string" },
                "priority": { "enum": ["alta", "media", "bassa"] },
                "target_user": {
                  "enum": ["pediatra", "educatore", "insegnante", "bibliotecario", "genitore", "caregiver", "formatore"]
                },
                "reason": { "type": "string", "minLength": 30 },
                "expected_items": { "type": "integer", "minimum": 2, "maximum": 8 }
              }
            }
          },
          "excluded_families": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["family_id", "reason"],
              "properties": {
                "family_id": {
                  "enum": ["F3-SIT-1", "F3-SIT-2", "F3-SIT-3", "F3-SIT-4", "F3-SIT-5", "F3-SIT-6", "F3-SIT-7", "F3-SIT-8", "F3-SIT-9"]
                },
                "reason": { "type": "string", "minLength": 20 }
              }
            }
          },
          "narrative_families_selected": {
            "type": "boolean",
            "description": "true se è selezionata almeno una famiglia tra F3-SIT-6, 7, 8, 9. Determina lo skip di f3_sit_step_3."
          }
        }
      }
    }
  }
}
