{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Schema per F3 STEP 5 (aprile 2026). Descrive la struttura dell'output di audit metodologico applicato all'output di F3 STEP 4.",
  "title": "AuditOutput",
  "description": "Output di F3 STEP 5: audit metodologico dell'output F3 STEP 4. Verifica la correttezza operativa dell'analisi prodotta: triangolazione reale vs. superficiale, validità dei proxy, coerenza classificatoria, gestione dell'ambiguità, rischio di falso positivo.",

  "type": "object",
  "required": ["step", "theme_id", "domain", "source_output_id", "case_audits", "global_analysis", "audit_result", "critical_issues", "strengths", "final_assessment", "final_assessment_qualifier"],
  "properties": {

    "step": {
      "type": "string",
      "const": "f3_step_5",
      "description": "Identificatore dello step di pipeline. Valore fisso."
    },

    "theme_id": {
      "type": "string",
      "description": "ID del tema, coerente con gli step precedenti."
    },

    "domain": {
      "type": "string",
      "description": "Dominio professionale del dispositivo auditato."
    },

    "source_output_id": {
      "type": "string",
      "description": "Identificatore dell'output F3 STEP 4 sottoposto ad audit."
    },

    "case_audits": {
      "type": "array",
      "description": "Audit per ciascun caso analizzato in F3 STEP 4. Un elemento per caso.",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/CaseAudit" }
    },

    "global_analysis": {
      "$ref": "#/definitions/GlobalAnalysis"
    },

    "audit_result": {
      "$ref": "#/definitions/AuditResult"
    },

    "critical_issues": {
      "type": "array",
      "description": "Elenco dei problemi critici rilevati. Vuoto se non ve ne sono.",
      "items": { "type": "string" }
    },

    "strengths": {
      "type": "array",
      "description": "Elenco dei punti di forza metodologici dell'output auditato.",
      "minItems": 1,
      "items": { "type": "string" }
    },

    "final_assessment": {
      "type": "string",
      "enum": ["robusto", "accettabile", "fragile", "non_valido"],
      "description": "Valutazione finale dell'output F3 STEP 4. robusto: metodo corretto, triangolazione reale, nessun problema critico. accettabile: metodo corretto con debolezze non critiche. fragile: problemi strutturali che limitano la validità. non_valido: errori critici che invalidano l'analisi."
    },

    "final_assessment_qualifier": {
      "type": "string",
      "description": "Qualificazione estesa del verdetto finale — precisa la natura specifica delle fragilità o dei punti di forza che sfumano la categoria enum. Obbligatorio."
    }

  },

  "definitions": {

    "CaseAudit": {
      "type": "object",
      "required": ["case_id", "checks"],
      "properties": {
        "case_id": {
          "type": "string",
          "enum": ["caso_A", "caso_B"]
        },
        "checks": {
          "type": "object",
          "required": [
            "completeness",
            "triangulation",
            "proxy_validity",
            "decisive_proxy_counter_reading",
            "proxy_classification_coherence",
            "proxy_confidence_check",
            "classification_status_check",
            "ambiguity_handling",
            "false_positive_risk"
          ],
          "properties": {
            "completeness": { "$ref": "#/definitions/Check_Completeness" },
            "triangulation": { "$ref": "#/definitions/Check_Triangulation" },
            "proxy_validity": { "$ref": "#/definitions/Check_ProxyValidity" },
            "decisive_proxy_counter_reading": { "$ref": "#/definitions/Check_CounterReading" },
            "proxy_classification_coherence": { "$ref": "#/definitions/Check_Coherence" },
            "proxy_confidence_check": { "$ref": "#/definitions/Check_ProxyConfidence" },
            "classification_status_check": { "$ref": "#/definitions/Check_ClassificationStatus" },
            "ambiguity_handling": { "$ref": "#/definitions/Check_AmbiguityHandling" },
            "false_positive_risk": { "$ref": "#/definitions/Check_FalsePositiveRisk" }
          }
        }
      }
    },

    "Check_Completeness": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": { "type": "string", "enum": ["completo", "incompleto"] },
        "notes": { "type": "string", "description": "Campi mancanti, se presenti." }
      }
    },

    "Check_Triangulation": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["reale", "superficiale", "assente"] },
        "notes": { "type": "string", "description": "Valutazione di ciascuno dei quattro elementi: proxies_present, proxies_direction, counter_indicator, counter_indicator_rebuttal." }
      }
    },

    "Check_ProxyValidity": {
      "type": "object",
      "required": ["result", "notes", "evidence_anchors"],
      "properties": {
        "result": { "type": "string", "enum": ["validi", "parzialmente_validi", "non_validi"] },
        "notes": { "type": "string", "description": "Per ciascun proxy: se è ancorato alla configurazione osservabile o introduce inferenze non giustificate." },
        "evidence_anchors": {
          "type": "array",
          "description": "Per ciascun proxy, l'elemento specifico della case_description che lo supporta. Se il proxy è ancorato alla observed_configuration invece che alla case_description, segnalare il rischio di circolarità.",
          "items": {
            "type": "object",
            "required": ["proxy_name", "evidence_element", "anchor_source"],
            "properties": {
              "proxy_name": { "type": "string" },
              "evidence_element": { "type": "string", "description": "Citazione o riferimento preciso all'elemento che supporta il proxy." },
              "anchor_source": { "type": "string", "enum": ["case_description", "observed_configuration", "inferenza_esterna"], "description": "Fonte dell'ancoraggio. Se observed_configuration o inferenza_esterna, il proxy ha rischio di circolarità o non-osservabilità." }
            }
          }
        }
      }
    },

    "Check_CounterReading": {
      "type": "object",
      "required": ["decisive_proxy", "counter_reading", "result"],
      "properties": {
        "decisive_proxy": { "type": "string", "description": "Il proxy identificato come decisivo in device_discrimination." },
        "counter_reading": { "type": "string", "description": "Come lo stesso elemento del proxy decisivo potrebbe essere riletto per sostenere la classificazione opposta." },
        "result": { "type": "string", "enum": ["proxy_decisivo_reversibile", "proxy_decisivo_stabile"], "description": "reversibile: la contro-lettura è strutturalmente plausibile. stabile: la contro-lettura non regge strutturalmente." }
      }
    },

    "Check_Coherence": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["coerente", "debole", "incoerente"] },
        "notes": { "type": "string", "description": "Se la classificazione segue dai proxy o è dichiarata indipendentemente." }
      }
    },

    "Check_ProxyConfidence": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["giustificata", "debole", "arbitraria"] },
        "notes": { "type": "string", "description": "Se proxy_confidence è giustificata dalla natura del proxy decisivo." }
      }
    },

    "Check_ClassificationStatus": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["corretto", "violato"] },
        "notes": { "type": "string", "description": "Se la corrispondenza alta→netta / media→probabile / bassa→ambigua è rispettata." }
      }
    },

    "Check_AmbiguityHandling": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["corretta", "insufficiente", "assente"] },
        "notes": { "type": "string", "description": "Se ambiguity_conditions sono esplicite e specifiche." }
      }
    },

    "Check_FalsePositiveRisk": {
      "type": "object",
      "required": ["result", "notes"],
      "properties": {
        "result": { "type": "string", "enum": ["gestito", "non_gestito"] },
        "notes": { "type": "string", "description": "Se il rischio di classificazione positiva senza bridge è segnalato e problematizzato." }
      }
    },

    "GlobalAnalysis": {
      "type": "object",
      "required": ["real_discrimination", "observer_dependency", "single_proxy_dependency"],
      "properties": {
        "real_discrimination": {
          "type": "object",
          "required": ["result", "notes"],
          "properties": {
            "result": { "type": "string", "enum": ["robusta", "fragile", "apparente"] },
            "notes": { "type": "string" }
          }
        },
        "observer_dependency": {
          "type": "object",
          "required": ["result", "notes"],
          "properties": {
            "result": { "type": "string", "enum": ["esplicita", "implicita", "non_gestita"] },
            "notes": { "type": "string" }
          }
        },
        "single_proxy_dependency": {
          "type": "object",
          "required": ["result", "notes"],
          "description": "Verifica se la discriminazione dipende da un solo proxy decisivo con confidence media o bassa. Se sì, la fragilità strutturale è concentrata in un punto unico e deve essere dichiarata.",
          "properties": {
            "result": { "type": "string", "enum": ["dipendenza_singola_dichiarata", "dipendenza_multipla", "non_verificato"] },
            "notes": { "type": "string" }
          }
        }
      }
    },

    "AuditResult": {
      "type": "object",
      "required": ["method_applied_correctly", "triangulation_quality", "false_positive_risk", "ambiguity_handling", "observer_dependency"],
      "properties": {
        "method_applied_correctly": { "type": "boolean" },
        "triangulation_quality": { "type": "string", "enum": ["reale", "superficiale", "assente"] },
        "false_positive_risk": { "type": "string", "enum": ["alto", "medio", "basso"] },
        "ambiguity_handling": { "type": "string", "enum": ["corretta", "insufficiente", "assente"] },
        "observer_dependency": { "type": "string", "enum": ["esplicita", "implicita", "non_gestita"] }
      }
    }

  }
}
