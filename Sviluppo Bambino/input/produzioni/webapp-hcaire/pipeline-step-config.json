    {
      "id": "f3_step_4",
      "label": "Verifica di coerenza F3",
      "phase": "F3",
      "_note": "r3: verifica obbligatoria del dispositivo tramite checklist di 10 controlli (5 di coerenza F3 sez. 2.7 + 4 di logica decisionale sez. 5.4 + 1 di auto-limitazione sez. 5.6).",
