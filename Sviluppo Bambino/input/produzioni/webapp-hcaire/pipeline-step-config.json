          "file_template": "inputs/temi/{tema_id}/f3-step-3-casi-{dominio}.json",
          "note": "Casi forniti dal ricercatore per stress test più ancorato al dominio. Se assenti, l'agente costruisce 5 casi in autonomia."
        }
      ],
      "verifica": true,
      "can_skip": false,
      "blocks": ["f3_step_4"]
