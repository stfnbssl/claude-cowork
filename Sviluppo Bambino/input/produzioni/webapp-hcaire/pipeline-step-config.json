        { "step": "f3_step_4", "role": "coerenza", "required": true }
      ],
      "inputs_strutturali": ["f3-step-5-audit-metodologico/audit-schema.json"],
      "inputs_esterni": [],
      "verifica": false,
      "can_skip": true,
      "skip_condition": "Step opzionale: eseguire solo prima della pubblicazione del dispositivo o quando entra in uso pratico",
