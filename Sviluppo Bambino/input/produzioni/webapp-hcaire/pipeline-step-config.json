          "file_template": "inputs/temi/{tema_id}/f3-step-1-dominio-{dominio}.json",
          "note": "Indicare dominio (clinico/educativo/formazione/politiche), context_label e note opzionali del ricercatore"
        }
      ],
      "verifica": true,
      "can_skip": false,
      "blocks": ["f3_step_2"]
    },
    {
      "id": "f3_step_2",
