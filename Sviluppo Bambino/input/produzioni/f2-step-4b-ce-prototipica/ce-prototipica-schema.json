{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "F2 Step 4b — CE Prototipica Schema",
  "description": "Schema per la Configurazione Evolutiva Prototipica (Grammatica CE) del tema",
  "type": "object",
  "required": ["step", "results"],
  "properties": {
    "step": {
      "type": "string",
      "const": "f2_step_4b"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ThemeCEPrototica"
      }
    }
  },
  "definitions": {
    "ThemeCEPrototica": {
      "type": "object",
      "required": [
        "theme_id",
        "ce_prototipica",
        "ce_notation",
        "ce_natural_language",
        "ce_variants",
        "derivation_notes"
      ],
      "properties": {
        "theme_id": {
          "type": "string",
          "description": "Identificatore del tema (stesso theme_id di STEP 4)"
        },
        "ce_prototipica": {
          "$ref": "#/definitions/ConfigurazioneEvolutiva"
        },
        "ce_notation": {
          "type": "string",
          "description": "Notazione formale completa della CE (formato: CE = S: ... R: ... D: ... T: ... A: ...)"
        },
        "ce_natural_language": {
          "type": "string",
          "description": "Descrizione in linguaggio non tecnico della CE (2-4 frasi, comprensibile senza i codici della grammatica)"
        },
        "ce_variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/CEVariant"
          },
          "description": "2-3 varianti strutturali della CE Prototipica"
        },
        "derivation_notes": {
          "type": "string",
          "description": "Note sulla derivazione: come i valori S, R, D, T, A derivano dalla micro-matrice di STEP 4"
        }
      }
    },
    "ConfigurazioneEvolutiva": {
      "type": "object",
      "required": ["S", "R", "D", "T", "A"],
      "properties": {
        "S": {
          "type": "array",
          "description": "Stato dei nodi canonici attivati nel tema",
          "items": {
            "$ref": "#/definitions/NodeState"
          },
          "minItems": 1
        },
        "R": {
          "type": "array",
          "description": "Relazioni dominanti tra nodi canonici (1-3 relazioni)",
          "items": {
            "$ref": "#/definitions/NodeRelation"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "D": {
          "type": "string",
          "enum": ["↗", "→", "↘"],
          "description": "Direzione dinamica prototipica del campo"
        },
        "T": {
          "type": "string",
          "enum": ["T1", "T2", "T3"],
          "description": "Stabilità temporale (T1 situazionale, T2 ricorrente, T3 stabilizzata)"
        },
        "A": {
          "type": "string",
          "enum": ["A+", "A±", "A-"],
          "description": "Abitabilità esperienziale (A+ abitabile, A± fragile, A- rischio collasso)"
        }
      }
    },
    "NodeState": {
      "type": "object",
      "required": ["node_id", "state", "rationale"],
      "properties": {
        "node_id": {
          "type": "string",
          "enum": ["N1", "N2", "N3", "N4", "N5", "N6", "N7"],
          "description": "ID del Nodo Trasversale canonico"
        },
        "state": {
          "type": "string",
          "enum": ["↑", "~", "↓", "!", "?"],
          "description": "Stato funzionale del nodo nella CE (↑ espansivo, ~ stabile, ↓ ristretto, ! disorganizzato, ? indeterminato)"
        },
        "rationale": {
          "type": "string",
          "description": "Motivazione strutturale dello stato assegnato (derivazione dalla micro-matrice)"
        }
      }
    },
    "NodeRelation": {
      "type": "object",
      "required": ["from_node", "to_node", "relation_type", "rationale"],
      "properties": {
        "from_node": {
          "type": "string",
          "enum": ["N1", "N2", "N3", "N4", "N5", "N6", "N7"]
        },
        "to_node": {
          "type": "string",
          "enum": ["N1", "N2", "N3", "N4", "N5", "N6", "N7"]
        },
        "relation_type": {
          "type": "string",
          "enum": ["CPL", "VIN", "MED", "CMP"],
          "description": "CPL=sostegno, VIN=vincolo, MED=mediazione, CMP=compensazione"
        },
        "rationale": {
          "type": "string",
          "description": "Motivazione strutturale della relazione (max 2 frasi)"
        }
      }
    },
    "CEVariant": {
      "type": "object",
      "required": ["variant_name", "modified_dimension", "modification_description", "structural_description"],
      "properties": {
        "variant_name": {
          "type": "string",
          "description": "Nome descrittivo della variante (es. 'CE chiudente', 'CE in attesa', 'CE disorganizzata')"
        },
        "modified_dimension": {
          "type": "string",
          "enum": ["S", "R", "D", "T", "A"],
          "description": "Quale dimensione grammaticale cambia rispetto alla CE Prototipica"
        },
        "modification_description": {
          "type": "string",
          "description": "Come cambia la dimensione modificata (es. 'N2 passa da ↑ a ~, D da ↗ a →')"
        },
        "structural_description": {
          "type": "string",
          "description": "Descrizione strutturale della variante: cosa caratterizza questa forma del tema"
        }
      }
    }
  }
}
