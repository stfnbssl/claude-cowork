{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcaire.local/schemas/theme-discovery.schema.json",
  "title": "ThemeDiscovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_scope",
    "candidate_themes",
    "global_notes"
  ],
  "properties": {
    "research_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_goal",
        "source_types_consulted",
        "selection_criteria"
      ],
      "properties": {
        "project_goal": {
          "type": "string"
        },
        "source_types_consulted": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selection_criteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "candidate_themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/themeCandidate"
      }
    },
    "global_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_assessment",
        "needs_human_review"
      ],
      "properties": {
        "overall_assessment": {
          "type": "string"
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "open_issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "themeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_label_provisional",
        "starting_point",
        "structural_focus",
        "what_it_is",
        "what_it_is_not",
        "why_it_matters",
        "source_signals",
        "possible_axes_involved",
        "definition_draft",
        "definition_risks",
        "exploratory_priority",
        "pilot_suitability",
        "human_review_notes"
      ],
      "properties": {
        "theme_label_provisional": {
          "type": "string"
        },
        "starting_point": {
          "type": "string"
        },
        "structural_focus": {
          "type": "string"
        },
        "what_it_is": {
          "type": "string"
        },
        "what_it_is_not": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "source_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSignal"
          }
        },
        "possible_axes_involved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axisHint"
          }
        },
        "possible_structural_nodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "possible_bridge_concepts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "definition_draft": {
          "type": "string"
        },
        "definition_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exploratory_priority": {
          "type": "string",
          "enum": ["alta", "media", "bassa"]
        },
        "pilot_suitability": {
          "type": "string",
          "enum": ["alta", "media", "bassa"]
        },
        "human_review_notes": {
          "type": "string"
        }
      }
    },
    "sourceSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "signal_summary"
      ],
      "properties": {
        "source_type": {
          "type": "string"
        },
        "source_title": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "description": "URL della fonte. Obbligatorio per source_type 'web_fetch' e 'web_search', omettere per 'training_knowledge'."
        },
        "signal_summary": {
          "type": "string"
        },
        "recency_relevance": {
          "type": "string",
          "enum": ["alta", "media", "bassa"]
        }
      }
    },
    "axisHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "axis_name",
        "reason"
      ],
      "properties": {
        "axis_id": {
          "type": "string"
        },
        "axis_name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}