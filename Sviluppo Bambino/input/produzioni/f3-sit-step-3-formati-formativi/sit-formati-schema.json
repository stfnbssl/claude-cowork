{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "f3-sit-step-3-formati-formativi-schema",
  "title": "F3-SIT Step 3 — Trasformazione formativa e narrativa",
  "type": "object",
  "required": ["step", "tema_id", "domain_selected", "results"],
  "properties": {
    "step": { "const": "f3_sit_step_3" },
    "tema_id": { "type": "string" },
    "domain_selected": { "enum": ["clinico", "educativo", "formazione", "politiche"] },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["training_outputs"],
        "properties": {
          "training_outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "format_id",
                "family_id",
                "title",
                "source_sit_id",
                "configurational_basis",
                "naive_reading",
                "configurational_reading",
                "content",
                "non_prescriptive_note",
                "methodological_warnings"
              ],
              "properties": {
                "format_id": { "enum": ["vignetta", "storyboard", "linea_guida", "prompt_ai"] },
                "family_id": { "enum": ["F3-SIT-6", "F3-SIT-7", "F3-SIT-8", "F3-SIT-9"] },
                "title": { "type": "string", "minLength": 5 },
                "source_sit_id": {
                  "anyOf": [
                    { "type": "string", "pattern": "^F3-SIT-[0-9]{3}$" },
                    { "type": "null" }
                  ]
                },
                "configurational_basis": {
                  "type": "object",
                  "required": ["dominant_node", "function", "target_field", "universal_device_type"],
                  "properties": {
                    "source_device_id": { "type": ["string", "null"] },
                    "dominant_node": { "type": "string", "minLength": 1 },
                    "function": { "enum": ["stabilizzare", "ampliare", "mediare", "proteggere"] },
                    "target_field": { "type": "string", "minLength": 1 },
                    "universal_device_type": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "enum": ["U1", "U2", "U3", "U4", "U5", "U6"] }
                    }
                  }
                },
                "naive_reading": { "type": ["string", "null"] },
                "configurational_reading": { "type": "string", "minLength": 30 },
                "content": { "type": "string", "minLength": 30 },
                "panels": {
                  "type": "array",
                  "description": "Solo per format_id = storyboard.",
                  "items": {
                    "type": "object",
                    "required": ["panel", "visual_description", "field_function"],
                    "properties": {
                      "panel": { "type": "integer", "minimum": 1 },
                      "visual_description": { "type": "string", "minLength": 10 },
                      "dialogue": { "type": ["string", "null"] },
                      "field_function": { "type": "string", "minLength": 5 }
                    }
                  }
                },
                "discussion_questions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "ai_generation_prompt": { "type": ["string", "null"] },
                "non_prescriptive_note": { "type": "string", "minLength": 20 },
                "methodological_warnings": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
